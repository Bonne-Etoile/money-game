# Godot
.godot/
*.translation

# Exports and gdUnit4 reports: generated inside the project, hidden from Godot by a
# committed .gdignore (otherwise Godot imports them and puts them in the exports).
/build/*
!/build/.gdignore
/reports/*
!/reports/.gdignore

# Android build template, installed by Godot (make android)
/android/

# AdMob plugin: binaries (installed by tools/install-admob-binaries.sh) and downloads
/addons/admob/android/bin/
/addons/admob/ios/bin/
/addons/admob/downloads/

# Python tooling
/.venv/
__pycache__/
