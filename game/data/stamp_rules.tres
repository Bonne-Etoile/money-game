[gd_resource type="Resource" script_class="StampRules" format=3]

[ext_resource type="Script" path="res://game/data/stamp_rules.gd" id="1_rules"]
[ext_resource type="Resource" path="res://game/data/piece_shapes.tres" id="2_shapes"]
[ext_resource type="Script" path="res://game/data/score_rules.gd" id="3_score"]
[ext_resource type="Script" path="res://game/data/stamp_level.gd" id="4_level"]

[sub_resource type="Resource" id="scoring"]
script = ExtResource("3_score")
points_per_cell_placed = 1
points_per_cell_cleared = 10
multi_clear_bonus_percent = 50
combo_bonus_percent = 50
combo_grace_moves = 2

[sub_resource type="Resource" id="level_1"]
script = ExtResource("4_level")
heights = Array[String](["222222", "222222", "111111", "111111"])
symbol_seed = 1

[sub_resource type="Resource" id="level_2"]
script = ExtResource("4_level")
heights = Array[String](["123321", "233332", "233332", "123321"])
symbol_seed = 2

[sub_resource type="Resource" id="level_3"]
script = ExtResource("4_level")
heights = Array[String](["122221", "233332", "234432", "234432", "233332", "122221"])
symbol_seed = 3

[resource]
script = ExtResource("1_rules")
pile_size = 6
grid_size = 8
symbol_count = 5
match_size = 3
preview_count = 2
shape_keys = Array[String](["i4h", "i4v", "o2", "t4a", "t4b", "t4c", "t4d", "l4a", "l4b", "l4c", "l4d", "j4a", "j4b", "j4c", "j4d", "s4h", "s4v", "z4h", "z4v"])
fallback_keys = Array[String](["i3h", "i3v", "c3a", "c3b", "c3c", "c3d", "i2h", "i2v", "dot"])
shape_set = ExtResource("2_shapes")
scoring = SubResource("scoring")
levels = Array[ExtResource("4_level")]([SubResource("level_1"), SubResource("level_2"), SubResource("level_3")])
